workDir = '/scratch2/fs1/dspencer/ilya/nf-work'

params {
    samples = null
    target_bed = null
    outdir = 'results'
    postfix = null  // Required: supply --postfix on the command line
    wgbs_root = '/storage2/fs1/dspencer/Active/spencerlab/data/wgbs'
}

process {
    errorStrategy = 'terminate'

    withName: METHFAST {
        cpus = 1
        memory = '32 GB'
    }

    withName: MERGE_BEDS {
        cpus = 1
        memory = '4 GB'
        time = '2h'
    }
}

conda {
    enabled = false
    useMicromamba = false
}

executor {
    queueSize = 15
    submitRateLimit = '1/1sec'
}

//workflow {
//    failOnIgnore = false
//}

report {
    enabled = true
    file = 'report.html'
    overwrite = true
}

timeline {
    enabled = true
    file = 'timeline.html'
    overwrite = true
}

trace {
    enabled = true
    file = 'trace.txt'
    overwrite = true
}

profiles {
    slurm {
        process.executor = 'slurm'
        process.queue = 'condo-dspencer'
        process.clusterOptions = '--account=compute2-dspencer'
    }
    local {
        process.executor = 'local'
    }
}
